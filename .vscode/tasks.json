{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "make all",
			"command": "/usr/bin/make",
			"args": [
				"-j"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
		}
	],
	"version": "2.0.0"
}
